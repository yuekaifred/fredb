package website

templ websiteIndex() {
	<html>
	<head>
		<title>Placeholder Widgets Co</title>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body data-lang="curl">
		<div class="page">
			<!-- <header class="header">
				<span>db.fredyang.com</span>
				<nav>
					<a href="/robot">I am a Robot</a>
					<a href="/salesperson">I am a Salesperson</a>
				</nav>
			</header> -->
			<div class="hero">
				<div class="hero-action">
					<button class="primary-btn" hx-post="/provision" hx-target="#result" hx-swap="innerHTML">Create a database</button>
					<div id="result" class="key-field">
						<textarea readonly>************************</textarea>
						<button type="button" class="copy-btn" disabled aria-label="Copy">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
						</button>
					</div>
				</div>
				<div class="hero-copy">
					<h1>Fredb is a free, fast, and dead simple key value store.</h1>
					<p>Generating an API key will automatically provision a database with that key. Built for fast prototyping.</p>
				</div>
			</div>
			<section class="demo">
				<h2>Usage</h2>
				<div class="lang-tabs">
					<button type="button" class="lang-tab active" onclick="setLang('curl', this)">curl</button>
					<button type="button" class="lang-tab" onclick="setLang('js', this)">JavaScript</button>
					<button type="button" class="lang-tab" onclick="setLang('go', this)">Go</button>
					<button type="button" class="lang-tab" onclick="setLang('python', this)">Python</button>
					<button type="button" class="lang-tab" onclick="setLang('rust', this)">Rust</button>
					<button type="button" class="lang-tab" onclick="setLang('ruby', this)">Ruby</button>
					<button type="button" class="lang-tab" onclick="setLang('java', this)">Java</button>
					<button type="button" class="lang-tab" onclick="setLang('php', this)">PHP</button>
				</div>
				<div class="demo-grid">
					for _, e := range endpoints {
						@demoCell(e)
					}
				</div>
			</section>
			<section class="limits">
				<h2>Limits</h2>
				<table class="limits-table">
					<tr><th>Max value size</th><td>50MB per key</td></tr>
					<tr><th>Storage cap</th><td>1GB per tenant</td></tr>
				</table>
				<h3>Throughput</h3>
				<table class="rate-table">
					<tr><th></th><th>Write</th><th>Read / Range</th></tr>
					<tr><th>Burst capacity</th><td>10MB</td><td>80MB</td></tr>
					<tr><th>Sustained rate</th><td>5MB/s</td><td>40MB/s</td></tr>
				</table>
				<p>Every request costs an extra 1KB overhead.</p>
				<p>At 5MB/s sustained, that's roughly 5,000 1KB writes/sec, or 40,000 1KB reads/sec.</p>
			</section>
			<section class="disclaimer">
				<h2>Disclaimer</h2>
				<p>Fredb is still a personal project! As of writing, please do not rely on Fredb to:</p>
				<ul>
					<li>Store sensitive data</li>
					<li>Always be available</li>
				</ul>
        <p>As I'm working on this, your data could be lost at anytime.</p>
				<p>I don't want to be the reason why your demo stops working in front of the entire company. That being said, I'll be doing my absolute best not to be.</p>
			</section>
		</div>
		<script>
			var EXT = {
				curl: "sh", js: "js", go: "go", python: "py",
				rust: "rs", ruby: "rb", java: "java", php: "php"
			};
			var VARS = /\b(YOUR_API_KEY|YOUR_KEY|YOUR_VALUE|START_KEY|END_KEY)\b/g;
			function highlight(text) {
				var escaped = text
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;");
				return escaped.replace(VARS, '<span class="path-param">$1</span>');
			}
			function loadExamples(lang) {
				var ext = EXT[lang];
				document.querySelectorAll(".demo-cell").forEach(function(cell) {
					var endpoint = cell.dataset.endpoint;
					var pre = cell.querySelector(".example");
					fetch("/static/_examples/" + endpoint + "/example." + ext)
						.then(function(r) { return r.text(); })
						.then(function(t) { pre.innerHTML = highlight(t); })
						.catch(function() { pre.textContent = "failed to load example"; });
				});
			}
			function setLang(lang, btn) {
				document.body.dataset.lang = lang;
				document.querySelectorAll(".lang-tab").forEach(function(b) {
					b.classList.remove("active");
				});
				btn.classList.add("active");
				loadExamples(lang);
			}
			window.addEventListener("DOMContentLoaded", function() {
				loadExamples("curl");
			});
		</script>
	</body>
	</html>
}

templ loadTestPage() {
	<html>
	<head>
		<title>Load Test — Fredb</title>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body>
		<div class="page loadtest-page">
			<a href="/" class="back-link">&larr; back</a>
			<h1>Load Test</h1>
			<p>Hammer the api directly with your own script (any key that's already been provisioned works — <code>X-Api-Key</code> header, hit <code>/key/&lt;key&gt;</code> or <code>/range</code>). These numbers are live and global across every tenant hitting the server right now, updating every second.</p>
			<div class="stat-grid">
				<div class="stat-card">
					<span class="stat-value" id="stat-rps">—</span>
					<span class="stat-label">requests/sec</span>
				</div>
				<div class="stat-card">
					<span class="stat-value" id="stat-p50">—</span>
					<span class="stat-label">p50 latency (ms)</span>
				</div>
				<div class="stat-card">
					<span class="stat-value" id="stat-p99">—</span>
					<span class="stat-label">p99 latency (ms)</span>
				</div>
				<div class="stat-card">
					<span class="stat-value" id="stat-limited">—</span>
					<span class="stat-label">rate-limited (429s)</span>
				</div>
				<div class="stat-card">
					<span class="stat-value" id="stat-errors">—</span>
					<span class="stat-label">error rate</span>
				</div>
				<div class="stat-card">
					<span class="stat-value" id="stat-total">—</span>
					<span class="stat-label">total requests</span>
				</div>
			</div>
			<canvas id="sparkline" width="900" height="160"></canvas>
		</div>
		<script>
			var API_BASE = (location.hostname === "localhost" || location.hostname === "127.0.0.1")
				? "http://" + location.hostname + ":8080"
				: "https://db.fredyang.com";

			var canvas = document.getElementById("sparkline");
			var ctx = canvas.getContext("2d");

			function pct(x) {
				return (x * 100).toFixed(1) + "%";
			}

			function drawSparkline(history) {
				var w = canvas.width, h = canvas.height;
				ctx.clearRect(0, 0, w, h);
				var max = Math.max.apply(null, history.map(function(p) { return p.count; }).concat([1]));
				var stepX = w / Math.max(history.length - 1, 1);
				ctx.beginPath();
				history.forEach(function(p, i) {
					var x = i * stepX;
					var y = h - (p.count / max) * (h - 10) - 5;
					if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
				});
				ctx.strokeStyle = "#00b359";
				ctx.lineWidth = 2;
				ctx.stroke();
			}

			function poll() {
				fetch(API_BASE + "/stats")
					.then(function(r) { return r.json(); })
					.then(function(s) {
						document.getElementById("stat-rps").textContent = s.req_per_sec;
						document.getElementById("stat-p50").textContent = s.p50_ms;
						document.getElementById("stat-p99").textContent = s.p99_ms;
						document.getElementById("stat-limited").textContent = pct(s.limited_rate);
						document.getElementById("stat-errors").textContent = pct(s.error_rate);
						document.getElementById("stat-total").textContent = s.total;
						drawSparkline(s.history);
					})
					.catch(function() {});
			}
			poll();
			setInterval(poll, 1000);
		</script>
	</body>
	</html>
}

templ demoCell(e Endpoint) {
	<div class="demo-cell" data-endpoint={ e.ID }>
		<span class={ e.MethodClass() }>{ e.Method }</span>
		<code>@templ.Raw(e.PathHTML())</code>
		<p>{ e.Desc }</p>
		<table class="shape">
			for _, r := range e.Rows {
				<tr><th>{ r.Label }</th><td>{ r.Value }</td></tr>
			}
		</table>
		<pre class="example">loading...</pre>
	</div>
}

templ websiteKey(apiKey string) {
	<textarea readonly>{ apiKey }</textarea>
	<button type="button" class="copy-btn" aria-label="Copy" onclick="navigator.clipboard.writeText(this.previousElementSibling.value); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 250)">
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
	</button>
}

templ websiteError(msg string) {
	<textarea readonly>{ msg }</textarea>
}
