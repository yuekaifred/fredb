package website

templ limitsSection() {
	<section class="limits" id="limits">
		<h2>Limits</h2>
		@limitsBody()
	</section>
}

templ limitsBody() {
	<table class="limits-table">
		<tr><th>Max value size</th><td>50MB per key</td></tr>
		<tr><th>Storage cap</th><td>1GB per tenant</td></tr>
	</table>
}
