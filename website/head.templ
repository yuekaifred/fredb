package website

templ favicon() {
	<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMiAzMiI+PHJlY3Qgd2lkdGg9IjMyIiBoZWlnaHQ9IjMyIiBmaWxsPSIjMDBlNjc2Ii8+PC9zdmc+"/>
}

templ stylesheet() {
	<style>
		@font-face {
			font-family: "Share Tech Mono";
			src: url("https://fonts.gstatic.com/s/sharetechmono/v15/J7aHnp1uDWRBEqV98dVQztYldFcLowEF.woff2") format("woff2");
			font-weight: normal;
			font-style: normal;
		}
		:root {
			--page-margin-x: 1.5rem;
			--page-margin-top: 1.5rem;
			--accent-bg: #00e676;
			--accent-text: #00190c;
			--accent-shadow: #00b359;
			--bg: #1c1c1c;
			--bg-raised: #232323;
			--soft-bg: #262626;
			--soft-text: #8c8c8c;
			--soft-border: #3d3d3d;
			--soft-shadow: #0e0e0e;
			--text: #a8a8a8;
			--text-bright: #cfcfcf;
			--disabled-text: #4a4a4a;
			--topbar-height: 4rem;
			--control-height: 3.5rem;
			--sidenav-width: 9rem;
			--sidenav-gap: 2rem;
			--code-font: ui-monospace, "Cascadia Code", "SF Mono", Consolas, "Courier New", monospace;
		}
		* {
			font-family: "Share Tech Mono", ui-monospace, "SF Mono", Consolas, monospace;
			box-sizing: border-box;
		}
		html {
			font-size: 108%;
		}
		body {
			margin: 0;
			padding-top: var(--topbar-height);
			background:
				repeating-linear-gradient(0deg, rgba(255,255,255,0.012) 0px, rgba(255,255,255,0.012) 1px, transparent 1px, transparent 3px),
				var(--bg);
			color: var(--text);
		}
		.shell {
			display: flex;
			align-items: flex-start;
			gap: var(--sidenav-gap);
			max-width: calc(1000px + var(--sidenav-gap) + var(--sidenav-width));
			margin: 0 auto;
			padding: 0 var(--page-margin-x);
			box-sizing: border-box;
		}
		.topbar {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 100;
			background: var(--bg-raised);
			border-bottom: 1px solid var(--soft-border);
			box-sizing: border-box;
			--control-height: 2.5rem;
		}
		.topbar-inner {
			display: flex;
			align-items: center;
			gap: 1.5rem;
			max-width: calc(1000px + var(--sidenav-gap) + var(--sidenav-width));
			margin: 0 auto;
			padding: 0.75rem var(--page-margin-x);
			box-sizing: border-box;
		}
		.topbar-inner::before {
			content: "";
			flex: 0 0 calc(var(--sidenav-width) + var(--sidenav-gap));
		}
		.topbar .primary-btn {
			width: auto;
			font-size: 1rem;
			padding: 0 1.25rem;
			box-shadow: 0 2px 0 var(--accent-shadow);
			transform: translateY(-2px);
		}
		.topbar .primary-btn:active {
			transform: translateY(0);
			box-shadow: 0 0 0 var(--accent-shadow);
		}
		.topbar .key-field {
			margin-top: 0;
		}
		.topbar .key-field .key-display {
			font-size: 0.9rem;
			padding: 0 0.75rem;
		}
		.page {
			flex: 1 1 auto;
			min-width: 0;
			max-width: 1000px;
			padding-top: var(--page-margin-top);
			box-sizing: border-box;
		}
		.side-nav {
			position: sticky;
			top: calc(var(--topbar-height) + 2rem);
			flex: 0 0 var(--sidenav-width);
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			margin-top: var(--page-margin-top);
			box-sizing: border-box;
		}
		.side-nav a {
			color: var(--soft-text);
			text-decoration: none;
			font-weight: bold;
			font-size: 0.9rem;
			padding: 0.5rem 0 0.5rem 0.75rem;
			border-left: 2px solid transparent;
			transition: color 0.1s ease, border-color 0.1s ease;
		}
		.side-nav a:hover,
		.side-nav a.active {
			color: var(--text-bright);
			border-left-color: var(--accent-bg);
		}
		@media (max-width: 1200px) {
			.shell {
				flex-direction: column;
			}
			.page {
				max-width: none;
				padding-top: 0;
				width: 100%;
			}
			.topbar-inner {
				max-width: 1000px;
			}
			.topbar-inner::before {
				display: none;
			}
			.side-nav {
				flex: 0 0 auto;
				position: static;
				flex-direction: row;
				align-items: center;
				width: 100%;
				margin-top: var(--page-margin-top);
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--soft-border);
			}
			.side-nav a {
				margin-left: 1.5rem;
				padding: 0 0 0.15rem;
				border-left: none;
			}
			.side-nav a:first-child {
				margin-left: 0;
			}
			.side-nav a:hover,
			.side-nav a.active {
				border-left: none;
				box-shadow: 0 2px 0 var(--accent-bg);
			}
			.key-prefix {
				display: none;
			}
		}
		.hero {
			margin-top: 3rem;
			box-sizing: border-box;
		}
		.hero-copy {
			display: flex;
			flex-direction: column;
			flex: 1 1 auto;
		}
		.hero-copy h1 {
			margin-top: 0;
			font-size: 1.75rem;
			font-weight: bold;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.02em;
		}
		.hero-copy p {
			color: var(--soft-text);
		}
		.robot-note {
			font-style: normal;
			font-size: 0.9rem;
			color: var(--soft-text);
		}
		.robot-note code {
			font-family: var(--code-font);
			font-weight: normal;
			font-size: 0.85rem;
			color: var(--text);
			background: var(--soft-bg);
			border: 1px solid var(--soft-border);
			padding: 0.1rem 0.4rem;
		}
		.robot-link {
			color: var(--accent-bg);
			font-weight: bold;
			text-decoration: none;
			box-shadow: 0 2px 0 var(--accent-shadow);
		}
		.robot-link:hover {
			color: #1aeb87;
		}
		.primary-btn {
			font-family: inherit;
			font-size: 1.5rem;
			font-weight: bold;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--accent-bg);
			color: var(--accent-text);
			border: 1px solid var(--accent-shadow);
			border-radius: 0;
			box-sizing: border-box;
			height: var(--control-height);
			padding: 0 1.75rem;
			width: 20rem;
			white-space: nowrap;
			cursor: pointer;
			box-shadow: 0 3px 0 var(--accent-shadow);
			transition: transform 0.05s ease, box-shadow 0.05s ease;
		}
		.primary-btn:hover {
			background: #1aeb87;
		}
		.primary-btn:active {
			transform: translateY(3px);
			box-shadow: 0 0 0 var(--accent-shadow);
		}
		.key-field {
			display: flex;
			align-items: center;
			margin-top: 1.25rem;
			min-width: 0;
		}
		.key-display {
			position: relative;
			display: flex;
			align-items: center;
			font-size: 1.15rem;
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			padding: 0 1.25rem;
			height: var(--control-height);
			box-sizing: border-box;
			background: var(--soft-bg);
			border: 1px solid var(--soft-border);
			letter-spacing: 0.15rem;
			color: var(--text);
			cursor: pointer;
		}
		.key-display .key-prefix {
			user-select: none;
			color: var(--soft-text);
			margin-right: 0.5rem;
		}
		.key-display .key-value {
			user-select: text;
		}
		.key-display .key-mask {
			position: relative;
			top: 0.2em;
			user-select: none;
		}
		.key-display .key-hover-label {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--accent-bg);
			color: var(--accent-text);
			font-weight: bold;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.1s ease;
		}
		.key-display:hover .key-hover-label,
		.key-display.show-label .key-hover-label {
			opacity: 1;
		}
		.key-display.disabled {
			cursor: not-allowed;
			color: var(--disabled-text);
		}
		.demo {
			margin-top: 3rem;
			box-sizing: border-box;
		}
		.demo h2 {
			font-size: 1.4rem;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			border-bottom: 1px solid var(--soft-border);
			padding-bottom: 0.5rem;
		}
		.endpoint-list {
			margin-top: 1rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.endpoint-row {
			border: 1px solid var(--soft-border);
			background: var(--bg-raised);
			padding: 0.85rem 1rem;
		}
		.usage-list {
			margin-top: 1rem;
		}
		.usage-row {
			padding: 0.85rem 0;
			border-top: 1px solid var(--soft-border);
		}
		.usage-row:first-child {
			border-top: none;
			padding-top: 0;
		}
		.endpoint-heading {
			margin: 0 0 0.5rem;
			color: var(--text-bright);
		}
		.endpoint-row-head {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
		.endpoint-row-head code {
			font-family: var(--code-font);
			font-size: 0.95rem;
			color: var(--text);
		}
		.path-param {
			font-style: normal;
			font-weight: bold;
			color: var(--text-bright);
		}
		.method {
			display: inline-block;
			flex: 0 0 auto;
			width: 4.5rem;
			text-align: center;
			vertical-align: middle;
			font-weight: bold;
			font-size: 0.8rem;
			letter-spacing: 0.03em;
			padding: 0.2rem 0.5rem;
			border-radius: 0;
			color: var(--soft-text);
			background: var(--soft-bg);
			border: 1px solid var(--soft-border);
		}
		.endpoint-desc {
			margin: 0.3rem 0 0;
			color: var(--soft-text);
		}
		.lang-selector {
			display: flex;
			gap: 1.5rem;
			margin-top: 1rem;
		}
		.lang-btn {
			background: none;
			border: none;
			font-family: inherit;
			font-weight: bold;
			font-size: 0.9rem;
			color: var(--soft-text);
			cursor: pointer;
			padding: 0 0 0.15rem;
			box-shadow: none;
			transition: color 0.1s ease, box-shadow 0.1s ease;
		}
		.lang-btn:hover,
		.lang-btn.active {
			color: var(--text-bright);
			box-shadow: 0 2px 0 var(--accent-bg);
		}
		.section-divider {
			border: none;
			border-top: 1px solid var(--soft-border);
			margin: 1rem 0;
		}
		.code-block[data-lang] {
			display: none;
		}
		body[data-lang="curl"] .code-block[data-lang="curl"],
		body[data-lang="js"] .code-block[data-lang="js"],
		body[data-lang="go"] .code-block[data-lang="go"],
		body[data-lang="python"] .code-block[data-lang="python"] {
			display: block;
		}
		.api-key-note {
			margin-top: 1.25rem;
			color: var(--soft-text);
		}
		.api-key-note code {
			font-family: var(--code-font);
			background: var(--soft-bg);
			border: 1px solid var(--soft-border);
			border-radius: 0;
			padding: 0.1rem 0.4rem;
			font-size: 0.85rem;
			color: var(--text);
		}
		.limits {
			margin-top: 3rem;
			box-sizing: border-box;
		}
		.limits h2 {
			font-size: 1.4rem;
			margin-bottom: 1rem;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			border-bottom: 1px solid var(--soft-border);
			padding-bottom: 0.5rem;
		}
		.limits h3 {
			font-size: 1rem;
			margin-top: 2rem;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.03em;
		}
		.limits-table {
			width: 100%;
			border-collapse: collapse;
		}
		.limits-table tr {
			border-top: 1px solid var(--soft-border);
		}
		.limits-table th, .limits-table td {
			text-align: left;
			padding: 0.6rem 0;
			vertical-align: top;
		}
		.limits-table th {
			color: var(--soft-text);
			font-weight: normal;
			width: 10rem;
			white-space: nowrap;
			padding-right: 0.75rem;
		}
		.limits-table td {
			font-weight: bold;
			color: var(--text);
		}
		.rate-table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 0.5rem;
		}
		.rate-table tr {
			border-top: 1px solid var(--soft-border);
		}
		.rate-table th, .rate-table td {
			text-align: left;
			padding: 0.6rem 0.75rem 0.6rem 0;
			vertical-align: top;
		}
		.rate-table th {
			color: var(--soft-text);
			font-weight: normal;
		}
		.rate-table tr:first-child th {
			border-top: none;
		}
		.rate-table tr:first-child {
			border-top: none;
		}
		.rate-table td {
			font-weight: bold;
			color: var(--text);
		}
		.limits ul {
			margin: 0.5rem 0;
			padding-left: 1.25rem;
			color: var(--soft-text);
		}
		.limits > p {
			color: var(--soft-text);
		}
		.disclaimer {
			margin: 3rem 0;
			box-sizing: border-box;
			border: 1px solid var(--soft-border);
			background: var(--bg-raised);
			padding: 1.25rem 1.5rem;
		}
		.disclaimer h2 {
			font-size: 1.4rem;
			margin-bottom: 1rem;
			margin-top: 0;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}
		.disclaimer p {
			margin: 0.75rem 0;
			color: var(--soft-text);
		}
		.disclaimer ul {
			margin: 0.5rem 0;
			padding-left: 1.25rem;
			color: var(--soft-text);
		}
		.docs-section, .status-section {
			margin-top: 3rem;
			box-sizing: border-box;
		}
		.docs-section h2, .status-section h2 {
			font-size: 1.4rem;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			border-bottom: 1px solid var(--soft-border);
			padding-bottom: 0.5rem;
		}
		.docs-section h3 {
			font-size: 1rem;
			margin-top: 2rem;
			color: var(--text-bright);
			text-transform: uppercase;
			letter-spacing: 0.03em;
		}
		.docs-section p, .status-sub {
			color: var(--soft-text);
		}
		.code-block {
			margin: 0.75rem 0 0;
			padding: 0.85rem 1rem;
			background: var(--soft-bg);
			border: 1px solid var(--soft-border);
		}
		.code-block code {
			font-family: var(--code-font);
			font-size: 0.85rem;
			color: var(--text);
			white-space: pre-wrap;
			word-break: break-word;
		}
		.stat-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
			gap: 1rem;
			margin-top: 1rem;
		}
		.stat-tile {
			border: 1px solid var(--soft-border);
			background: var(--bg-raised);
			padding: 0.85rem 1rem;
		}
		.stat-value {
			font-size: 1.5rem;
			font-weight: bold;
			color: var(--text-bright);
		}
		.stat-label {
			margin-top: 0.25rem;
			font-size: 0.8rem;
			color: var(--soft-text);
			text-transform: uppercase;
			letter-spacing: 0.03em;
		}
		.feed-table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 0.5rem;
			font-size: 0.9rem;
		}
		.feed-table th, .feed-table td {
			text-align: left;
			padding: 0.5rem 0.5rem 0.5rem 0;
			vertical-align: top;
		}
		.feed-table th {
			color: var(--soft-text);
			font-weight: normal;
		}
		.status-ok {
			color: var(--text);
		}
		.status-warn, .status-err {
			color: var(--text-bright);
			font-weight: bold;
		}
		.status-empty {
			margin-top: 1rem;
			color: var(--soft-text);
		}
	</style>
}

