package website

templ heroSection() {
	<div class="topbar">
		<div class="topbar-inner">
			<button class="primary-btn" hx-post="/ui/provision" hx-target="#result" hx-swap="innerHTML">Create a database</button>
			<div id="result" class="key-field">
				<div class="key-display disabled" aria-disabled="true">
					<span class="key-prefix" aria-hidden="true">API_KEY:</span><span class="key-value key-mask">************************************************</span>
				</div>
			</div>
		</div>
	</div>
	<div class="hero">
		<div class="hero-copy">
			<h1>Fredb is a free, fast, and dead simple key value store.</h1>
			<p>Generating an API key will automatically provision a database with that key. Built for fast prototyping.</p>
			<p class="robot-note">
				<code>curl db.fredyang.com/robot</code>{ " for LLM friendly project specs or " }<a class="robot-link" href="/robot">click here <span aria-hidden="true">&rarr;</span></a>
			</p>
		</div>
	</div>
	<script>
		function copyKey(el) {
			if (el.classList.contains('disabled')) {
				return;
			}
			const value = el.querySelector('.key-value').textContent;
			navigator.clipboard.writeText(value);
			const label = el.querySelector('.key-hover-label');
			label.textContent = 'Copied';
			el.classList.add('show-label');
			clearTimeout(el._copyTimeout);
			el._copyTimeout = setTimeout(function() {
				el.classList.remove('show-label');
				label.textContent = 'Click to copy';
			}, 1200);
		}
	</script>
}
