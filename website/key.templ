package website

templ websiteKey(apiKey string) {
	<div class="key-display" tabindex="0" role="button" aria-label="Copy API key" onclick="copyKey(this)">
		<span class="key-prefix" aria-hidden="true">API_KEY:</span><span class="key-value">{ apiKey }</span>
		<span class="key-hover-label">Click to copy</span>
	</div>
}

templ websiteError(msg string) {
	<div class="key-display disabled" aria-disabled="true">
		<span class="key-value">{ msg }</span>
	</div>
}
